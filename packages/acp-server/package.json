{
  "name": "@spiritagent/acp-server",
  "version": "0.3.2",
  "description": "ACP (Agent Client Protocol) server adapter for Spirit Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/SpiritAgent.git",
    "directory": "packages/acp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/stdio-entry.js",
  "types": "./dist/src/types.d.ts",
  "bin": {
    "spirit-agent-acp": "./dist/src/stdio-entry.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build && node ../../scripts/npm/assert-no-file-deps.mjs",
    "notice": "node scripts/gen-notice.mjs",
    "notice:production": "node scripts/gen-notice.mjs --production"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.1",
    "@inquirer/prompts": "^7.5.0",
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/host-internal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^5.6.3"
  }
}
