<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Taken from nodejs/node's tools/osx-entitlements.plist: upstream ships node with these permissions; re-signing overrides them, and missing entries crash V8 at runtime. -->
    <!-- Upstream's com.apple.security.get-task-allow is deliberately dropped: it is a debugging entitlement that lets any process attach a debugger. -->
    <!-- Only used for the node/ subtree of release bundles; spirit and rg are pure Rust binaries and need no exemptions. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
